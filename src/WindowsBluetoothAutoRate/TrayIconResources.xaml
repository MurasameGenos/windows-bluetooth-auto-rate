<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <XamlUICommand
        x:Key="ShowWindowCommand"
        Description="打开设置窗口"
        Label="打开设置" />

    <XamlUICommand
        x:Key="ExitApplicationCommand"
        Description="退出应用"
        Label="退出" />

    <tb:TaskbarIcon
        x:Key="TrayIcon"
        IconSource="/Assets/AppIcon.ico"
        LeftClickCommand="{StaticResource ShowWindowCommand}"
        NoLeftClickDelay="True"
        ToolTipText="Windows 蓝牙音频自动格式"
        Visibility="Visible">
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{StaticResource ShowWindowCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{StaticResource ExitApplicationCommand}" />
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
